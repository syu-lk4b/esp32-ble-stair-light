#pragma once

// ---------------------------------------------------------------------------
// Copy this file to include/secrets.h and fill in your own values.
// include/secrets.h is git-ignored and must never be committed.
// ---------------------------------------------------------------------------

// 2.4 GHz Wi-Fi only - the ESP32-S3 has no 5 GHz radio.
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// Home Assistant base URL (no trailing slash) and a long-lived access token.
// Profile -> Security -> Long-lived access tokens -> Create token.
#define HA_BASE_URL "http://homeassistant.local:8123"
#define HA_TOKEN "paste-your-long-lived-token-here"

// Advertised BLE names of the two stair light controllers.
// These are the names the vendor app shows during pairing.
#define BLE_NAME_DOWN "downstair"
#define BLE_NAME_UP   "upstair"

// Built-in timer schedule pushed by the "SYNC TIME" button.
#define TIMER_ON_HOUR  18
#define TIMER_ON_MIN   0
#define TIMER_OFF_HOUR 23
#define TIMER_OFF_MIN  45

// Optional HTTP Basic auth for the web UI and the API.
// Leave WEB_PASS empty ("") to disable auth (LAN-only setups).
#define WEB_USER "admin"
#define WEB_PASS ""

// Optional static IP. Leave all three empty to use DHCP.
#define STATIC_IP   ""
#define STATIC_GW   ""
#define STATIC_MASK ""

// mDNS hostname -> http://stair-panel.local
#define MDNS_HOST "stair-panel"
